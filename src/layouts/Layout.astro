---
import GoogleAnalytics from "@components/analytics/GoogleAnalytics.astro";
import La51Analytics from "@components/analytics/La51Analytics.astro";
import MicrosoftClarity from "@components/analytics/MicrosoftClarity.astro";
import UmamiAnalytics from "@components/analytics/UmamiAnalytics.astro";
import CodeGroupManager from "@components/features/CodeGroupManager.astro";
import FancyboxManager from "@components/features/FancyboxManager.astro";
import FontSetup from "@components/features/FontSetup.astro";
import SakuraEffect from "@components/features/SakuraEffect.astro";
import ConfigCarrier from "@components/layout/ConfigCarrier.astro";

import {
	analyticsConfig,
	expressiveCodeConfig,
	navbarMode,
	profileConfig,
	siteConfig,
} from "@/config";
import { PAGE_WIDTH } from "@/constants/constants";
import { defaultFavicons } from "@/constants/icon";
import type { Favicon } from "@/types/config";
import { isHomePage } from "@/utils/layout-utils";
import { getAuthorAvatarUrl, getSiteLogo } from "@/utils/schema-image";
import { buildSiteGraph, toAbsoluteUrl } from "@/utils/schema-utils";
import { getOgLocale } from "@/utils/site-config-utils";
import { getCanonicalUrl, url } from "@/utils/url-utils";

import "@/styles/main.css";
import "@/styles/immersive-reading.css";
import "@/styles/variables.styl";
import "@rehype-callouts-theme";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCoverImage?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
}

let {
	title,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCoverImage,
	ogImageWidth: propsOgImageWidth,
	ogImageHeight: propsOgImageHeight,
	ogImageAlt: propsOgImageAlt,
} = Astro.props;

const isHomePageCheck = isHomePage(Astro.url.pathname);

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
// apple-touch-icon：优先取 favicon 中的 png，否则取第一个
const appleTouchIcon =
	favicons.find((f) => f.src.toLowerCase().endsWith(".png")) ?? favicons[0];

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

// 首页站点级结构化数据用的作者头像 URL（Person.image），经 toAbsoluteImageUrl 三分解析
const avatarUrl = await getAuthorAvatarUrl();
// 作者个人页（/about/）绝对 URL，作为 Person.url
const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;
// 站点 publisher logo（Organization.logo），用于首页 @graph 的 Organization 节点
const siteLogo = await getSiteLogo();

// canonical：对 /archive/ 与 /search/ 剥离查询串，避免筛选视图自我 canonical 到 ?tag= 等
const canonicalUrl = getCanonicalUrl(Astro.url);

// OG 图片：文章走生成图/封面，非文章页回退到站点 logo
let ogImageUrl: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;
const isGeneratedOg = siteConfig.post.generateOgImages && postSlug;
if (isGeneratedOg) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
	ogImageWidth = 1200;
	ogImageHeight = 630;
} else if (postCoverImage) {
	ogImageUrl = postCoverImage; // 已由文章页算成绝对 URL
	ogImageWidth = propsOgImageWidth;
	ogImageHeight = propsOgImageHeight;
} else if (siteLogo?.url) {
	ogImageUrl = siteLogo.url;
	ogImageWidth = siteLogo.width;
	ogImageHeight = siteLogo.height;
}
const ogImageAlt = propsOgImageAlt ?? pageTitle;
---

<!doctype html>
<html lang={siteLang} class="bg-(--page-bg) text-[14px] md:text-[16px]" data-tag-style={siteConfig.tagStyle ?? "pill"} data-category-style={siteConfig.categoryStyle ?? "rectangle"}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline>
			@layer properties, theme, base, components, utilities;
		</style>
    {analyticsConfig?.googleAnalyticsId && (
            <GoogleAnalytics analyticsId={analyticsConfig.googleAnalyticsId} />
    )}
    {analyticsConfig?.microsoftClarityId && (
            <MicrosoftClarity clarityId={analyticsConfig.microsoftClarityId} />
    )}
        {analyticsConfig?.umamiAnalytics?.websiteId && (
          <UmamiAnalytics
          websiteId={analyticsConfig.umamiAnalytics.websiteId}
          scriptUrl={analyticsConfig.umamiAnalytics.scriptUrl}
          replaysScriptUrl={analyticsConfig.umamiAnalytics.replaysScriptUrl}
          trackOutboundLinks={analyticsConfig.umamiAnalytics.trackOutboundLinks}
          collectWebVitals={analyticsConfig.umamiAnalytics.collectWebVitals}
          replays={analyticsConfig.umamiAnalytics.replays}
          />
        )}
        {analyticsConfig?.la51Analytics?.Id && (
            <La51Analytics
            analyticsId={analyticsConfig.la51Analytics.Id}
            sdkUrl={analyticsConfig.la51Analytics?.sdkUrl}
            ck={analyticsConfig.la51Analytics?.ck}
            autoTrack={analyticsConfig.la51Analytics?.autoTrack}
            hashMode={analyticsConfig.la51Analytics?.hashMode}
            screenRecord={analyticsConfig.la51Analytics?.screenRecord}
            />
    )}

    <title>{pageTitle}</title>
    <meta
      name="description"
      content={description || siteConfig.description || pageTitle}
    />
    {
      siteConfig.keywords && siteConfig.keywords.length > 0 && (
        <meta name="keywords" content={siteConfig.keywords.join(", ")} />
      )
    }
    <meta name="author" content={profileConfig.name} />

    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:locale" content={getOgLocale(lang)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description || siteConfig.description || pageTitle}
    />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageUrl && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {
      setOGTypeArticle ? (
        <meta property="og:type" content="article" />
      ) : (
        <meta property="og:type" content="website" />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={description || siteConfig.description || pageTitle}
    />

    {
      isHomePageCheck && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(
            buildSiteGraph({
              site: siteConfig.site_url,
              siteConfig,
              profileConfig,
              lang: siteLang,
              authorUrl: aboutUrl,
              avatarUrl,
              logo: siteLogo,
            }),
          )}
        />
      )
    }

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={`hsl(${siteConfig.themeColor.hue} 90% 60%)`} />
    {
      favicons.map((favicon) => (
        <link
          rel="icon"
          href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
          sizes={favicon.sizes}
          media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
        />
      ))
    }
    {appleTouchIcon && (
      <link
        rel="apple-touch-icon"
        href={appleTouchIcon.src.startsWith("/") ? url(appleTouchIcon.src) : appleTouchIcon.src}
        type="image/png"
        sizes={appleTouchIcon.sizes}
      />
    )}

    <!-- 为特定域名的图片添加 referrerpolicy 以解决 403 问题 -->
    <!-- 注：静态图片（ImageWrapper 组件、Markdown 正文图）已在构建期加好 referrerpolicy；
         此脚本仅作为运行时兜底，处理解密内容等动态注入的图片。 -->
    {siteConfig.imageOptimization?.noReferrerDomains &&
     siteConfig.imageOptimization.noReferrerDomains.length > 0 && (
      <script
        is:inline
        define:vars={{
          noReferrerDomains: JSON.stringify(
            siteConfig.imageOptimization.noReferrerDomains
          ),
        }}
      >
        (function() {
          const domains = JSON.parse(noReferrerDomains);

          // 域名匹配函数，支持通配符
          function matchesDomain(urlStr, patterns) {
            try {
              const urlObj = new URL(urlStr);
              const hostname = urlObj.hostname;

              return patterns.some(function(pattern) {
                const regexPattern = pattern.replace(/\./g, '\\.').replace(/\*/g, '.*');
                const regex = new RegExp('^' + regexPattern + '$');
                return regex.test(hostname);
              });
            } catch (e) {
              return false;
            }
          }

          // 处理单个图片元素
          function processImage(img) {
            if (!img.src || img.hasAttribute('referrerpolicy')) return;

            if (matchesDomain(img.src, domains)) {
              img.setAttribute('referrerpolicy', 'no-referrer');
            }
          }

          // 兜底扫描一次当前页面（构建期已处理的图片会因已有属性而快速跳过）
          document.querySelectorAll('img').forEach(processImage);

          // 使用 MutationObserver 监听动态加载/注入的图片
          const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              mutation.addedNodes.forEach(function(node) {
                if (node.nodeName === 'IMG') {
                  processImage(node);
                }
                if (node.querySelectorAll) {
                  node.querySelectorAll('img').forEach(processImage);
                }
              });
            });
          });

          observer.observe(document.documentElement, {
            childList: true,
            subtree: true
          });
        })();
      </script>
    )}

    <!-- Set the theme before the page is rendered to avoid a flash -->
    <script
      is:inline
      define:vars={{
        configHue,
        defaultMode: siteConfig.themeColor.defaultMode ?? "light",
        darkTheme: expressiveCodeConfig.darkTheme,
        lightTheme: expressiveCodeConfig.lightTheme,
      }}
    >
      // 主题初始化 - 与setting-utils.ts保持一致
      const LIGHT_MODE = "light";
      const DARK_MODE = "dark";
      const SYSTEM_MODE = "system";

      // 获取存储的主题，如果没有则使用默认值
      const theme = localStorage.getItem("theme") || defaultMode;

      // 获取系统主题
      function getSystemTheme() {
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? DARK_MODE
          : LIGHT_MODE;
      }

      // 解析主题（如果是system模式，则获取系统主题）
      function resolveTheme(themeValue) {
        if (themeValue === SYSTEM_MODE) {
          return getSystemTheme();
        }
        return themeValue;
      }

      const resolvedTheme = resolveTheme(theme);
      const isDark = resolvedTheme === DARK_MODE;

      // 应用主题
      if (isDark) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }

      // Set the theme for Expressive Code
      document.documentElement.setAttribute(
        "data-theme",
        isDark ? darkTheme : lightTheme
      );

      // Load the hue from local storage
      const hue = localStorage.getItem("hue") || configHue;
      document.documentElement.style.setProperty("--hue", hue);
    </script>
    <style
      define:vars={{
        configHue,
        "page-width": `${siteConfig.pageWidth ?? PAGE_WIDTH}rem`,
      }}
    ></style>
    <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

    <slot name="head" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={profileConfig.name}
      href={`${Astro.site}rss.xml`}
    />

    <link
      rel="alternate"
      type="application/atom+xml"
      title={profileConfig.name}
      href={`${Astro.site}atom.xml`}
    />

    <!-- Font Setup (Astro Font API) -->
    <FontSetup />
  </head>
  <body
    class="min-h-screen"
    class:list={[
      {
        "is-home": isHomePageCheck,
        "sticky-navbar": navbarMode === "fixed",
        "dynamic-navbar": navbarMode === "dynamic",
      },
    ]}
  >
    <div id="progress-bar"></div>

    {/* 卡片样式：根据 localStorage 覆盖默认配置 */}
    <script is:inline define:vars={{
      defaultBorder: siteConfig.card?.border ?? false,
      defaultFollowTheme: siteConfig.card?.followTheme ?? false,
    }}>
      (function() {
        var stored = localStorage.getItem("cardBorderEnabled");
        var border = stored !== null ? stored === "true" : defaultBorder;
        if (border) document.documentElement.classList.add("enable-card-border");
        else document.documentElement.classList.remove("enable-card-border");

        stored = localStorage.getItem("cardFollowThemeEnabled");
        var follow = stored !== null ? stored === "true" : defaultFollowTheme;
        if (follow) document.body.classList.add("card-follow-theme-hue");
        else document.body.classList.remove("card-follow-theme-hue");
      })();
    </script>

    <ConfigCarrier />
    <slot />

    <!-- Sakura Effect -->
    <SakuraEffect />

    <!-- Fancybox Manager -->
    <FancyboxManager />

    <!-- Tab 代码块交互 -->
    <CodeGroupManager />

  </body>
</html>


<script>
  import { initLayout } from "@/utils/layout-init";
  initLayout();
</script>
