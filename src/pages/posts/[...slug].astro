---
import { render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSeriesPosts, getSortedPosts } from "@utils/content-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import SeriesNav from "@/components/misc/SeriesNav.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import {
	getAuthorAvatarUrl,
	getSiteLogo,
	toAbsoluteImageInfo,
} from "@/utils/schema-image";
import {
	buildBreadcrumbList,
	buildPersonEntity,
	buildPublisherEntity,
	toAbsoluteUrl,
} from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { remarkPluginFrontmatter } = await render(entry);

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);
const showPostCover = Boolean(processedImage && coverImageConfig.enableInPost);
const usePostCoverOverlay =
	showPostCover && (coverImageConfig.enableInPostOverlay ?? true);

const coverBasePath = getFileDirFromPath(entry.filePath || "");
const coverImage =
	(await toAbsoluteImageInfo(
		processedImage,
		coverBasePath,
		siteConfig.site_url,
	)) ?? undefined;

// 作者个人页（/about/）绝对 URL，用于 author.url 指向唯一标识作者的页面
const aboutUrl =
	toAbsoluteUrl("/about/", siteConfig.site_url) ?? siteConfig.site_url;

// 作者实体：与首页/about 的 Person 共用同一 @id（#person），author 用 @id 关联
const authorAvatarUrl = await getAuthorAvatarUrl();
const authorPerson = buildPersonEntity({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: aboutUrl,
	avatarUrl: authorAvatarUrl,
	description: profileConfig.bio,
});

// publisher 实体（Organization，含真实 logo），article 的 publisher 用其 @id 关联
const publisher = buildPublisherEntity({
	site: siteConfig.site_url,
	siteConfig,
	logo: await getSiteLogo(),
});

const breadcrumbItems = [
	{
		name: i18n(I18nKey.home),
		url: toAbsoluteUrl("/", siteConfig.site_url) ?? siteConfig.site_url,
	},
];
if (entry.data.category) {
	breadcrumbItems.push({
		name: entry.data.category,
		url:
			toAbsoluteUrl(getCategoryUrl(entry.data.category), siteConfig.site_url) ??
			siteConfig.site_url,
	});
}
breadcrumbItems.push({ name: entry.data.title, url: Astro.url.toString() });

const breadcrumbList = buildBreadcrumbList(breadcrumbItems);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "BlogPosting",
			headline: entry.data.title,
			description: entry.data.description || entry.data.title,
			keywords: entry.data.tags.length ? entry.data.tags.join(", ") : undefined,
			author: { "@id": authorPerson["@id"] },
			publisher: { "@id": publisher["@id"] },
			...(coverImage
				? {
						image: {
							"@type": "ImageObject",
							url: coverImage.url,
							contentUrl: coverImage.url,
							...(coverImage.width ? { width: coverImage.width } : {}),
							...(coverImage.height ? { height: coverImage.height } : {}),
						},
					}
				: {}), // 优化：有封面才输出，避免 image:null
			datePublished: entry.data.published.toISOString(),
			...(entry.data.category ? { articleSection: entry.data.category } : {}),
			...(remarkPluginFrontmatter.words
				? { wordCount: remarkPluginFrontmatter.words }
				: {}),
			...(entry.data.updated
				? { dateModified: entry.data.updated.toISOString() }
				: {}),
			mainEntityOfPage: { "@type": "WebPage", "@id": Astro.url.toString() },
			url: Astro.url.toString(),
			inLanguage: entry.data.lang
				? entry.data.lang.replace("_", "-")
				: siteConfig.lang.replace("_", "-"),
		},
		authorPerson,
		publisher,
		breadcrumbList,
	],
};

const seriesData = await getSeriesPosts(entry);
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCoverImage={coverImage?.url}
  postCategory={entry.data.category || undefined}
  ogImageWidth={coverImage?.width}
  ogImageHeight={coverImage?.height}
  ogImageAlt={entry.data.title}
  headings={headings}
  encrypted={!!entry.data.password}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />

  <!-- og:article 结构化元数据 -->
  <meta slot="head" property="article:published_time" content={entry.data.published.toISOString()} />
  {entry.data.updated && (
    <meta slot="head" property="article:modified_time" content={entry.data.updated.toISOString()} />
  )}
  <meta slot="head" property="article:author" content={entry.data.author || profileConfig.name} />
  {entry.data.category && (
    <meta slot="head" property="article:section" content={entry.data.category} />
  )}
  {entry.data.tags.map((tag) => (
    <meta slot="head" property="article:tag" content={tag.trim()} />
  ))}
  {/* 加密/密码保护文章：内容不可被爬取，标注 noindex, noarchive */}
  {entry.data.password && (
    <meta slot="head" name="robots" content="noindex, noarchive" />
  )}

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {
        usePostCoverOverlay && processedImage && (
          <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="h-full"
              preview={false}
              apiUrls={apiUrls}
            />
            <div class="absolute inset-x-4 top-3 z-10 flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs font-medium text-white drop-shadow-[0_1px_2px_rgb(0_0_0/0.9)]">
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon name="material-symbols:notes-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.words}
                  {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                </span>
              </div>
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.minutes}
                  {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                </span>
              </div>
              {entry.data.password && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon name="material-symbols:lock-outline" class="text-base" />
                  <span>{i18n(I18nKey.postEncrypted)}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
              <div
                data-pagefind-body
                data-pagefind-weight="10"
                data-pagefind-meta="title"
                class="mb-2 text-xl md:text-2xl font-bold leading-tight text-white"
              >
                {entry.data.title}
              </div>
              <PostMetadata
                variant="cover"
                className="gap-x-4 gap-y-1"
                published={entry.data.published}
                updated={entry.data.updated}
                category={entry.data.category || undefined}
                tags={entry.data.tags}
              />
            </div>
          </div>
        )
      }

      <!-- word count and reading time -->
      {
        !usePostCoverOverlay && (
          <div
            class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
          >
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name="material-symbols:notes-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.words}
                {" " + i18n(I18nKey.wordsCount)}
              </div>
            </div>
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon name="material-symbols:schedule-outline-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.minutes}
                {
                  " " +
                    i18n(
                      remarkPluginFrontmatter.minutes === 1
                        ? I18nKey.minuteCount
                        : I18nKey.minutesCount
                    )
                }
              </div>
            </div>
            {entry.data.password && (
              <div class="flex flex-row items-center">
                <div
                  class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                >
                  <Icon name="material-symbols:lock-outline" />
                </div>
                <div class="text-sm">
                  {i18n(I18nKey.postEncrypted)}
                </div>
              </div>
            )}
          </div>
        )
      }

      <!-- title -->
      {
        !usePostCoverOverlay && (
          <div class="relative onload-animation">
            <div
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="transition w-full block font-bold mb-3
                        text-3xl md:text-[2.25rem]/[2.75rem]
                        text-black/90 dark:text-white/90
                        md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                        before:absolute before:top-3 before:-left-4.5"
            >
              {entry.data.title}
            </div>
          </div>
        )
      }

      <!-- metadata -->
      {
        !usePostCoverOverlay && (
          <div class="onload-animation">
            <PostMetadata
              className="mb-5"
              published={entry.data.published}
              updated={entry.data.updated}
              tags={entry.data.tags}
              category={entry.data.category || undefined}
            />
            {
              !showPostCover && (
                <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
              )
            }
          </div>
        )
      }

      {
        seriesData && (
          <SeriesNav
            seriesName={seriesData.seriesName}
            posts={seriesData.posts}
            currentPostId={entry.id}
          />
        )
      }

      {
        showPostCover && !usePostCoverOverlay && processedImage && (
          <div class="mt-4">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              alt={entry.data.title}
              class="mb-8 rounded-xl onload-animation"
              preview={false}
              naturalHeight
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  {
    siteConfig.post.postNavigation && (
      <div
        class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
      >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
        <Icon
          name="material-symbols:chevron-left-rounded"
          class="text-[2rem] text-(--primary)"
        />
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.nextTitle || i18n(I18nKey.home)}
        </div>
      </div>
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.prevTitle || i18n(I18nKey.home)}
        </div>
        <Icon
          name="material-symbols:chevron-right-rounded"
          class="text-[2rem] text-(--primary)"
        />
      </div>
    </a>
      </div>
    )
  }

</MainGridLayout>
